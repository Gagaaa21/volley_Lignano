# Supabase — Project Settings -> API
# Se queste due variabili non sono impostate, l'app usa automaticamente dati
# demo in memoria (nessun setup richiesto per provare il sito in locale).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chiave segreta usata per firmare le sessioni di login (Developer/Admin).
# Obbligatoria in produzione. Generala con: openssl rand -base64 32
SESSION_SECRET=

# Notifiche push della PWA (aggiornamenti calendario). Genera la coppia con:
# npx web-push generate-vapid-keys
# Se non impostate, l'app funziona normalmente ma non invia notifiche.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@volleylignano.it

# IA di Google (Gemini) usata come ripiego per dividere in blocchi un testo di
# allenamento incollato con formattazione irregolare. Ottieni una chiave gratuita
# su https://aistudio.google.com/apikey . Se non impostata, viene usato solo il
# riconoscimento automatico normale (senza IA).
GEMINI_API_KEY=
